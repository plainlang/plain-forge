{
  "name": "plain-forge",
  "version": "1.0.19",
  "description": "Conversational spec-writing tool for ***plain specification language",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainlang/plain-forge.git"
  },
  "homepage": "https://github.com/plainlang/plain-forge",
  "bugs": {
    "url": "https://github.com/plainlang/plain-forge/issues"
  },
  "license": "MIT",
  "keywords": [
    "plain",
    "claude-code",
    "skills",
    "spec",
    "ai"
  ],
  "bin": {
    "plain-forge": "bin/cli.mjs"
  },
  "files": [
    "bin/cli.mjs",
    "forge"
  ],
  "scripts": {
    "build": "tsx bin/forge-build.ts",
    "clean": "tsx bin/forge-build.ts --clean",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
